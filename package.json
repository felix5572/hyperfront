		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@nktkas/hyperliquid": "^0.31.0",
		"@tailwindcss/vite": "^4.1.18",
